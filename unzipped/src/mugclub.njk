<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Join the Mug Club | Happy Valley Arcade Bar</title>
<meta name="description" content="Founders pricing for the Happy Valley Mug Club in Beacon, NY. $99 a year, first 50 members.">
<meta name="robots" content="noindex,follow">
<meta name="theme-color" content="#241436">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Monoton&family=Bungee&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#241436;--cyan:#00bfe0;--magenta:#ff2fb0;--orange:#ff7a2f;
    --violet:#7b3ff2;--yellow:#ffcc33;--paper:#fff3ea;--dim:rgba(255,243,234,.72);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:'Space Grotesk',system-ui,sans-serif;color:var(--paper);
    -webkit-font-smoothing:antialiased;line-height:1.5;
    background:
      radial-gradient(900px 520px at 80% -10%,rgba(0,191,224,.34),transparent 58%),
      radial-gradient(820px 540px at -10% 8%,rgba(255,47,176,.30),transparent 58%),
      radial-gradient(900px 560px at 50% 112%,rgba(255,204,51,.22),transparent 58%),
      var(--ink);
    background-attachment:fixed;
    min-height:100svh;
  }
  a{color:inherit;text-decoration:none}
  .page{
    max-width:560px;margin:0 auto;
    padding:22px 20px 0;
    display:flex;flex-direction:column;gap:18px;
    min-height:100svh;
  }
  .mark{display:flex;align-items:center;gap:10px;justify-content:center}
  .mark img{height:44px;width:auto;display:block}
  .mark span{
    font-family:'Bungee',sans-serif;font-size:15px;letter-spacing:1px;
    background:linear-gradient(90deg,var(--cyan),var(--magenta));
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }

  .hero{text-align:center}
  .eyebrow{
    display:inline-block;font-size:11px;letter-spacing:4px;text-transform:uppercase;
    font-weight:700;color:var(--yellow);margin-bottom:12px;
  }
  h1{
    font-family:'Monoton',cursive;font-weight:400;
    font-size:clamp(44px,15vw,72px);line-height:1.08;padding-bottom:.1em;
    background:linear-gradient(90deg,var(--cyan),var(--magenta),var(--orange));
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .sub{color:var(--dim);font-size:15.5px;margin-top:6px}

  .pricebox{
    background:rgba(255,255,255,.06);border:1px solid rgba(255,243,234,.16);
    border-radius:24px;padding:24px 20px;text-align:center;
    box-shadow:0 18px 44px rgba(0,0,0,.32);
  }
  .badge{
    display:inline-block;background:var(--yellow);color:var(--ink);
    font-weight:700;font-size:11px;letter-spacing:1.4px;text-transform:uppercase;
    padding:6px 14px;border-radius:999px;margin-bottom:14px;
  }
  .price{
    font-family:'Monoton',cursive;font-size:clamp(56px,18vw,84px);line-height:1;
    color:var(--yellow);text-shadow:0 4px 0 rgba(0,0,0,.25);
  }
  .per{font-size:14px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:10px}

  .perks{display:grid;gap:12px}
  .perk{
    display:flex;gap:13px;align-items:center;
    background:rgba(255,255,255,.05);border:1px solid rgba(255,243,234,.12);
    border-radius:15px;padding:14px 16px;
  }
  .ck{
    flex:none;width:28px;height:28px;border-radius:50%;
    background:linear-gradient(135deg,var(--cyan),var(--violet));
    display:flex;align-items:center;justify-content:center;
    font-size:15px;font-weight:700;color:#fff;
  }
  .perk b{font-weight:600;font-size:15.5px;display:block}
  .perk small{display:block;color:var(--dim);font-size:13px;margin-top:2px}

  .buybar{
    position:sticky;bottom:0;z-index:5;
    margin:0 -20px;padding:14px 20px calc(14px + env(safe-area-inset-bottom));
    background:linear-gradient(to top,var(--ink) 62%,rgba(36,20,54,0));
  }
  .buy{
    display:block;text-align:center;
    font-family:'Bungee',sans-serif;font-size:clamp(26px,7.5vw,34px);letter-spacing:1.5px;
    color:#fff;padding:24px 20px;border-radius:22px;
    background:linear-gradient(90deg,var(--magenta),var(--orange));
    box-shadow:0 14px 34px rgba(255,47,176,.42);
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .buy:active{transform:translateY(2px);box-shadow:0 8px 22px rgba(255,47,176,.42)}
  .fineprint{text-align:center;color:var(--dim);font-size:12.5px;margin-top:9px}
  .foot{
    text-align:center;color:rgba(255,243,234,.5);font-size:12.5px;
    letter-spacing:.4px;padding:4px 0 18px;
  }
  .foot a{border-bottom:1px solid rgba(255,243,234,.28)}

  @media (prefers-reduced-motion:reduce){.buy{transition:none}}
</style>
</head>
<body>
  <main class="page">
    <div class="mark">
      <img src="/happy-valley-logo.png" alt="">
      <span>HAPPY&nbsp;VALLEY</span>
    </div>

    <div class="hero">
      <span class="eyebrow">Members Only</span>
      <h1>Mug Club</h1>
      <p class="sub">Your own mug behind the bar. Drink like a regular.</p>
    </div>

    <div class="pricebox">
      <span class="badge">Founders pricing &middot; First 50</span>
      <div class="price">$99</div>
      <div class="per">A Year</div>
    </div>

    <div class="perks">
      <div class="perk"><span class="ck">&#10003;</span><span><b>Big Mug Perk</b><small>20 oz pours for the 16 oz price, every visit</small></span></div>
      <div class="perk"><span class="ck">&#10003;</span><span><b>First beer on us</b><small>The day you join</small></span></div>
      <div class="perk"><span class="ck">&#10003;</span><span><b>Birthday beer on us</b><small>Come celebrate</small></span></div>
      <div class="perk"><span class="ck">&#10003;</span><span><b>Annual Mug Club party</b><small>Members only, once a year</small></span></div>
    </div>

    <div class="buybar">
      <a class="buy" href="https://shop.happyvalleybeacon.com/pricing-plans/mugclub">BUY NOW</a>
      <p class="fineprint">Takes a minute. You'll set up an account on the next screen.</p>
    </div>

    <div class="foot">
      296 Main Street, Beacon NY &middot; <a href="https://happyvalleybeacon.com/">happyvalleybeacon.com</a>
    </div>
  </main>
</body>
</html>
