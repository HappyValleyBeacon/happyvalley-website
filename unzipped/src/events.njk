---
layout: "base.njk"
title: "Events & Game Nights | Happy Valley Arcade Bar, Beacon NY"
activeNav: "events"
description: "Trivia, arcade tournaments, karaoke and comedy at our Beacon arcade bar, plus the string-lit courtyard for groups."
permalink: "/events-color.html"
copyNote: ". Event dates subject to change; check Instagram."
eleventyExcludeFromCollections: true
---

<section class="mhead">
  <div class="wrap">
    <span class="eyebrow">{{ events.eyebrow }}</span>
    <h1>{{ events.heading }}</h1>
    <p>{{ events.intro }}</p>
  </div>
</section>

<!-- ROTATING & SPECIAL -->
<section class="block">
  <div class="wrap">
    <div class="sec-head">
      <div class="tag">Rotating &amp; Special</div>
      <h2>{{ events.rotating_heading }}</h2>
      <p>{{ events.rotating_note }}</p>
    </div>
    <div class="ev-grid">
      {% for item in events.rotating %}
      <div class="ev-card"><div class="band b{{ (loop.index0 % 4) + 1 }}"></div><div class="in">
        <h3>{{ item.title }}</h3>
        <div class="when">{{ item.when }}</div>
        <p>{{ item.description }}</p>
      </div></div>
      {% endfor %}
    </div>
  </div>
</section>

{% if events.flyers and events.flyers.length %}
<!-- FLYERS -->
<style>
  .flyer-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:22px}
  .flyer-card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:0 12px 30px rgba(36,20,54,.07);transition:.25s;display:block}
  .flyer-card:hover{transform:translateY(-6px);box-shadow:0 22px 50px rgba(123,63,242,.16)}
  .flyer-card img{width:100%;max-height:520px;object-fit:contain;background:#f4f1f8;display:block}
  .flyer-card .cap{padding:14px 16px;color:var(--muted);font-size:14px}
  @media(max-width:860px){.flyer-grid{grid-template-columns:repeat(auto-fill,minmax(180px,1fr))}}
  @media(max-width:520px){.flyer-grid{grid-template-columns:1fr}}
</style>
<section class="block">
  <div class="wrap">
    <div class="sec-head">
      <div class="tag">Coming Up</div>
      <h2>{{ events.flyers_heading }}</h2>
      <p>{{ events.flyers_note }}</p>
    </div>
    <div class="flyer-grid">
      {% for flyer in events.flyers %}
      {% if flyer.link %}
      <a class="flyer-card" href="{{ flyer.link }}" target="_blank" rel="noopener">
      {% else %}
      <div class="flyer-card">
      {% endif %}
        <img src="{{ flyer.image }}" alt="{{ flyer.caption or 'Event flyer' }}">
        {% if flyer.caption %}<div class="cap">{{ flyer.caption }}</div>{% endif %}
      {% if flyer.link %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- COURTYARD BOOKING -->
<section class="block">
  <div class="wrap split">
    <div class="art" style="background-image:url({{ events.courtyard.image }})"></div>
    <div>
      <h3>{{ events.courtyard.title }}</h3>
      <p>{{ events.courtyard.description }}</p>
      <div class="pill-list">
        {% for pill in events.courtyard.pills %}
        <span class="pill">{{ pill }}</span>
        {% endfor %}
      </div>
      <a class="btn primary" href="{{ events.courtyard.cta_url }}">{{ events.courtyard.cta_label }}</a>
    </div>
  </div>
</section>

<!-- PRIVATE BUYOUT -->
<section class="block">
  <div class="wrap">
    <div class="band-cta">
      <h3>{{ events.private_buyout.title }}</h3>
      <p>{{ events.private_buyout.description }}</p>
      <a class="btn solid" href="{{ events.private_buyout.cta_url }}">{{ events.private_buyout.cta_label }}</a>
    </div>
  </div>
</section>

<!-- FOLLOW FOR DATES -->
<section class="block">
  <div class="wrap">
    <div class="sec-head" style="margin-bottom:32px">
      <div class="tag">Never Miss a Night</div>
      <h2>Get the Dates</h2>
    </div>
    <div class="follow">
      <div class="cell">
        <div class="k">Follow Along</div>
        <div class="v"><a href="{{ events.follow.instagram_url }}" target="_blank" rel="noopener" style="color:inherit">{{ events.follow.instagram_handle }}</a></div>
        <p>All event dates, lineups, and last-minute pop-ups are posted on Instagram.</p>
      </div>
      <div class="cell">
        <div class="k">Call the Bar</div>
        <div class="v">{{ events.follow.phone }}</div>
        <p>{{ events.follow.phone_note }}</p>
      </div>
    </div>
  </div>
</section>
