---
layout: "base.njk"
title: "Events & Game Nights | Happy Valley Arcade Bar, Beacon NY"
activeNav: "events"
description: "What's coming up at Happy Valley: trivia, karaoke, comedy, tournaments and more."
permalink: "/events.html"
copyNote: ". Event dates subject to change; check Instagram."
eleventyExcludeFromCollections: true
---

<section class="mhead">
  <div class="wrap">
    <h1>{{ events.heading }}</h1>
    {% if events.subheading %}<p>{{ events.subheading }}</p>{% endif %}
  </div>
</section>

{% if events.flyers and events.flyers.length %}
<!-- FLYERS -->
<style>
  .flyer-hero{display:flex;justify-content:center;cursor:pointer;margin-bottom:22px}
  .flyer-hero img{width:auto;max-width:100%;max-height:640px;display:block;border-radius:24px;border:1px solid var(--line);box-shadow:0 16px 40px rgba(36,20,54,.09)}
  .flyer-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px}
  .flyer-thumb{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 10px 24px rgba(36,20,54,.07);transition:.2s;cursor:pointer}
  .flyer-thumb:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(123,63,242,.16)}
  .flyer-thumb img{width:100%;height:220px;object-fit:cover;display:block}
  @media(max-width:600px){.flyer-grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr))}.flyer-thumb img{height:150px}}

  .flyer-lightbox{position:fixed;inset:0;background:rgba(20,10,30,.92);z-index:500;display:none;align-items:center;justify-content:center;padding:24px}
  .flyer-lightbox.open{display:flex}
  .flyer-lightbox img{max-width:88vw;max-height:86vh;object-fit:contain;border-radius:10px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
  .fl-close{position:absolute;top:20px;right:24px;background:none;border:none;color:#fff;font-size:34px;line-height:1;cursor:pointer;padding:6px 12px}
  .fl-prev,.fl-next{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.12);border:none;color:#fff;font-size:26px;width:52px;height:52px;border-radius:50%;cursor:pointer}
  .fl-prev:hover,.fl-next:hover,.fl-close:hover{background:rgba(255,255,255,.22)}
  .fl-prev{left:16px}
  .fl-next{right:16px}
  @media(max-width:600px){.fl-prev,.fl-next{width:42px;height:42px;font-size:20px}.fl-prev{left:8px}.fl-next{right:8px}}
</style>
<section class="block" style="padding-top:0">
  <div class="wrap">
    <div class="flyer-hero" data-index="0">
      <img src="{{ events.flyers[0].image }}" alt="{{ events.flyers[0].caption or 'Event flyer' }}">
    </div>
    {% if events.flyers.length > 1 %}
    <div class="flyer-grid">
      {% for flyer in events.flyers %}
      {% if not loop.first %}
      <div class="flyer-thumb" data-index="{{ loop.index0 }}">
        <img src="{{ flyer.image }}" alt="{{ flyer.caption or 'Event flyer' }}">
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<div id="flyerLightbox" class="flyer-lightbox">
  <button class="fl-close" aria-label="Close">&times;</button>
  <button class="fl-prev" aria-label="Previous">&#8592;</button>
  <img id="flyerLightboxImg" src="" alt="Event flyer">
  <button class="fl-next" aria-label="Next">&#8594;</button>
</div>

<script>
(function(){
  var flyers = [{% for flyer in events.flyers %}"{{ flyer.image }}"{% if not loop.last %},{% endif %}{% endfor %}];
  var idx = 0;
  var lb = document.getElementById('flyerLightbox');
  var img = document.getElementById('flyerLightboxImg');
  function show(i){ idx = (i + flyers.length) % flyers.length; img.src = flyers[idx]; }
  function open(i){ show(i); lb.classList.add('open'); }
  function close(){ lb.classList.remove('open'); }
  document.querySelectorAll('.flyer-hero, .flyer-thumb').forEach(function(el){
    el.addEventListener('click', function(){ open(parseInt(el.getAttribute('data-index'), 10)); });
  });
  lb.querySelector('.fl-close').addEventListener('click', close);
  lb.querySelector('.fl-next').addEventListener('click', function(e){ e.stopPropagation(); show(idx + 1); });
  lb.querySelector('.fl-prev').addEventListener('click', function(e){ e.stopPropagation(); show(idx - 1); });
  lb.addEventListener('click', function(e){ if (e.target === lb) close(); });
  document.addEventListener('keydown', function(e){
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') show(idx + 1);
    if (e.key === 'ArrowLeft') show(idx - 1);
  });
})();
</script>
{% endif %}

<!-- PRIVATE BUYOUT -->
<section class="block">
  <div class="wrap">
    <div class="band-cta">
      <h3>{{ events.private_buyout.title }}</h3>
      <p>{{ events.private_buyout.description }}</p>
      <a class="btn solid" href="{{ events.private_buyout.cta_url }}">{{ events.private_buyout.cta_label }}</a>
    </div>
  </div>
</section>

<!-- FOLLOW FOR DATES -->
<section class="block">
  <div class="wrap">
    <div class="sec-head" style="margin-bottom:32px">
      <div class="tag">Never Miss a Night</div>
      <h2>Get the Dates</h2>
    </div>
    <div class="follow">
      <div class="cell">
        <div class="k">Follow Along</div>
        <div class="v"><a href="{{ events.follow.instagram_url }}" target="_blank" rel="noopener" style="color:inherit">{{ events.follow.instagram_handle }}</a></div>
        <p>All event dates, lineups, and last-minute pop-ups are posted on Instagram.</p>
      </div>
      <div class="cell">
        <div class="k">Call the Bar</div>
        <div class="v">{{ events.follow.phone }}</div>
        <p>{{ events.follow.phone_note }}</p>
      </div>
    </div>
  </div>
</section>
